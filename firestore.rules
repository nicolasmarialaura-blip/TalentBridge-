rules_version = '2';

// tNic / TalentBridge — Firestore Security Rules
//
// Modelo de datos:
//   users/{uid}                          - datos privados del usuario (solo dueño)
//   users/{uid}/private/{doc}            - subcolección privada (solo dueño)
//   candidates/{uid}                     - perfil público de candidato (signed-in read, owner write)
//   companies/{uid}                      - perfil público de empresa (signed-in read, owner write)
//   swipes/{swipeId}                     - like/pass (only Cloud Functions reads all; user reads only own)
//   matches/{matchId}                    - match mutuo (creado solo por Cloud Functions)
//   matches/{matchId}/messages/{msgId}   - chat (participantes leen/escriben)
//   pipelines/{companyUid}/items/{candUid} - kanban (solo empresa dueña)
//   interviews/{interviewId}             - agendamientos (participantes leen, empresa escribe)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isMatchParticipant(matchId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    // ── users (privado) ──
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /private/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── candidates (perfil público de discovery) ──
    match /candidates/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── companies (perfil público de discovery) ──
    match /companies/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── swipes (privados — Cloud Functions detectan match mutuo) ──
    match /swipes/{swipeId} {
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.kind in ['like', 'pass']
                    && request.resource.data.to is string;
      allow read: if isSignedIn() && resource.data.from == request.auth.uid;
      allow update, delete: if false;
    }

    // ── matches (solo Cloud Functions crean; participantes leen) ──
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create, update, delete: if false;

      // mensajes del chat
      match /messages/{messageId} {
        allow read: if isMatchParticipant(matchId);
        allow create: if isMatchParticipant(matchId)
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ── pipelines (kanban por empresa) ──
    match /pipelines/{companyUid} {
      allow read, write: if isOwner(companyUid);

      match /items/{candidateUid} {
        allow read, write: if isOwner(companyUid);
      }
    }

    // ── interviews ──
    match /interviews/{interviewId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.companyUid ||
        request.auth.uid == resource.data.candidateUid
      );
      allow create: if isSignedIn() &&
                    request.resource.data.companyUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.companyUid ||
        request.auth.uid == resource.data.candidateUid
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.companyUid;
    }

    // ── default deny ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
